# CONFIGURACIÓN DEL SCANNER Robot-Event-Windows
[SCANNER_SETTINGS]
MAX_FILE_SIZE_MB | 100
EXCLUDED_PATHS | C:\Windows;C:\Program Files;C:\Program Files (x86);C:\Program Files;C:\Users\dpacherrez\AppData;C:\ProgramData
EXCLUDED_EXTENSIONS | .exe;.dll;.msi;.tmp;.cache;.mp3;.mp4;.jpg;.jpeg;.png;.gif;.pdf;.doc;.docx;.zip;.rar;.7z;.iso;.bin;.dat;.pem;.key;.crt;.cer;.log;.cache;.bak;.jar;.xml;.html

# REGLAS
[SCANNER_RULES]

RULES3 | password_pass | Detecta Pass o Password | [Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]?\s*[:;=]\s*["']?([A-Za-z0-9_.\-@$#%!*?&]{4,64})["']? | High
RULES3 | password_clave | Detecta Clave o Contrasena | ([Cc][Ll][Aa][Vv][Ee]|[Cc][Oo][Nn][Tt][Rr][Aa][Ss][Ee][Ññ][Aa])\s*[:;=]\s*["']?([A-Za-z0-9_.\-@$#%!*?&]{4,64})["']? | High

# MONITOREO - SOLO EVENTOS

[MONITOR_SETTINGS]
ENABLE_MONITORING | true
MONITOR_ALL_DRIVES | true
MONITOR_SPECIFIC_PATHS | 


